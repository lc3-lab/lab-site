---
import { base } from '../utils/url';
const { title, description = 'LC³ Lab — Learning Sciences, Learning Analytics, and Educational Technologies at UIUC' } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: `${base}/research`, label: 'Research' },
  { href: `${base}/#people`, label: 'People' },
  { href: `${base}/join`, label: 'Join Us' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title === 'Home' ? 'LC³ Lab' : `${title} | LC³ Lab`}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header>
      <nav>
        <a href={`${base}/`} class="brand">LC<sup>3</sup> Lab</a>
        <ul>
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                class={currentPath === link.href || currentPath.startsWith(link.href.replace(/#.*$/, '') + '/') ? 'active' : ''}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>
        © 2026 LC³ Lab &middot; University of Illinois Urbana-Champaign
      </p>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --text: #111827;
    --text-secondary: #6b7280;
    --accent: #7c3aed;
    --accent-hover: #6d28d9;
    --bg: #ffffff;
    --bg-subtle: #f9fafb;
    --border: #e5e7eb;
    --max-width: 900px;
    --font: 'DM Sans', system-ui, -apple-system, sans-serif;
  }

  html {
    font-family: var(--font);
    color: var(--text);
    background: var(--bg);
    font-size: 16px;
    line-height: 1;
    font-weight: 400;
    letter-spacing: -0.01em;
    -webkit-font-smoothing: antialiased;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ── Navigation ── */
  header {
    position: sticky;
    top: 0;
    background: rgba(250, 252, 255, 0.97);
    backdrop-filter: blur(10px);
    box-shadow: 0 1px 6px rgba(0, 0, 0, 0.05);
    z-index: 100;
  }

  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  nav .brand {
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--text-secondary);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  nav .brand sup {
    font-size: 0.6em;
    vertical-align: super;
    line-height: 0;
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: 2rem;
  }

  nav ul a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.15s;
  }

  nav ul a:hover,
  nav ul a.active {
    color: var(--accent);
  }

  /* ── Main content ── */
  main {
    flex: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 1.5rem;
    width: 100%;
  }

  /* ── Footer ── */
  footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem;
    text-align: center;
    font-size: 0.825rem;
    color: var(--text-secondary);
    margin-top: auto;
  }

  footer a {
    color: var(--text-secondary);
  }

  /* ── Typography ── */
  h1 {
    font-size: 1.875rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  h2 {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  h3 {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
  }

  p {
    line-height: 1.55;
    color: var(--text);
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    color: var(--accent-hover);
  }

  /* ── Shared layout helpers ── */
  .section {
    margin-bottom: 3rem;
  }

  .section-label {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
    padding-left: 0.75rem;
    border-left: 3px solid var(--accent);
  }

  .tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 500;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    background: var(--bg-subtle);
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    nav ul { gap: 1.25rem; }
    main { padding: 2rem 1rem; }
    h1 { font-size: 1.5rem; }
  }
</style>
