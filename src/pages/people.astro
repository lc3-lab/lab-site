---
import Layout from '../layouts/Layout.astro';
import members from '../data/members.json';

const pi       = members.filter(m => m.role === 'pi');
const phd      = members.filter(m => m.role === 'phd');
const masters  = members.filter(m => m.role === 'masters');
const undergrad = members.filter(m => m.role === 'undergrad');

function initials(name) {
  return name.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase();
}
---

<Layout title="People" description="Meet the members of the LC³ Lab at UIUC.">
  <section class="section">
    <h1>People</h1>
  </section>

  <!-- PI -->
  {pi.map(m => (
    <section class="section">
      <p class="section-label">Principal Investigator</p>
      <div class="pi-card">
        <div class="avatar-lg">
          {m.image
            ? <img src={m.image} alt={m.name} />
            : <span>{initials(m.name)}</span>
          }
        </div>
        <div class="pi-info">
          <h2 class="member-name">{m.name}</h2>
          <p class="member-title">{m.title}</p>
          <p class="member-affil">{m.affiliation}</p>
          <p class="member-bio">{m.bio}</p>
          <div class="member-links">
            {m.website && <a href={m.website} target="_blank" rel="noopener">Website</a>}
            {m.email && <a href={`mailto:${m.email}`}>Email</a>}
            {m.google_scholar && <a href={m.google_scholar} target="_blank" rel="noopener">Google Scholar</a>}
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- PhD students -->
  {phd.length > 0 && (
    <section class="section">
      <p class="section-label">PhD Students</p>
      <div class="member-grid">
        {phd.map(m => (
          <div class="member-card">
            <div class="avatar-sm">
              {m.image
                ? <img src={m.image} alt={m.name} />
                : <span>{initials(m.name)}</span>
              }
            </div>
            <div>
              <h3 class="member-name">{m.name}</h3>
              <p class="member-title">{m.title}</p>
              <p class="member-bio-sm">{m.bio}</p>
              {m.email && <a href={`mailto:${m.email}`} class="member-email">{m.email}</a>}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Masters students -->
  {masters.length > 0 && (
    <section class="section">
      <p class="section-label">Masters Students</p>
      <div class="member-grid">
        {masters.map(m => (
          <div class="member-card">
            <div class="avatar-sm">
              {m.image
                ? <img src={m.image} alt={m.name} />
                : <span>{initials(m.name)}</span>
              }
            </div>
            <div>
              <h3 class="member-name">{m.name}</h3>
              <p class="member-title">{m.title}</p>
              <p class="member-bio-sm">{m.bio}</p>
              {m.email && <a href={`mailto:${m.email}`} class="member-email">{m.email}</a>}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Undergrad -->
  {undergrad.length > 0 && (
    <section class="section">
      <p class="section-label">Undergraduate Researchers</p>
      <div class="member-grid">
        {undergrad.map(m => (
          <div class="member-card">
            <div class="avatar-sm">
              {m.image
                ? <img src={m.image} alt={m.name} />
                : <span>{initials(m.name)}</span>
              }
            </div>
            <div>
              <h3 class="member-name">{m.name}</h3>
              <p class="member-title">{m.title}</p>
              <p class="member-bio-sm">{m.bio}</p>
              {m.email && <a href={`mailto:${m.email}`} class="member-email">{m.email}</a>}
            </div>
          </div>
        ))}
      </div>
    </section>
  )}
</Layout>

<style>
  h1 { margin-bottom: 0; }

  /* PI card */
  .pi-card {
    display: flex;
    gap: 1.75rem;
    align-items: flex-start;
  }

  .avatar-lg {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: #dbeafe;
    color: #1d4ed8;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 600;
    flex-shrink: 0;
    overflow: hidden;
  }

  .avatar-lg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pi-info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .member-name {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .member-title {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .member-affil {
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-style: italic;
  }

  .member-bio {
    font-size: 0.875rem;
    color: var(--text);
    margin-top: 0.25rem;
    max-width: 600px;
    line-height: 1.65;
  }

  .member-links {
    display: flex;
    gap: 1rem;
    margin-top: 0.25rem;
    flex-wrap: wrap;
  }

  .member-links a {
    font-size: 0.825rem;
    color: var(--accent);
  }

  /* Member grid */
  .member-grid {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .member-card {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }

  .member-card:first-child {
    border-top: 1px solid var(--border);
  }

  .avatar-sm {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #f3f4f6;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 600;
    flex-shrink: 0;
    overflow: hidden;
  }

  .avatar-sm img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .member-card h3 {
    font-size: 0.9rem;
    margin-bottom: 0.1rem;
  }

  .member-bio-sm {
    font-size: 0.825rem;
    color: var(--text-secondary);
    margin-top: 0.2rem;
    line-height: 1.55;
  }

  .member-email {
    font-size: 0.8rem;
    color: var(--accent);
    display: block;
    margin-top: 0.2rem;
  }

  @media (max-width: 560px) {
    .pi-card { flex-direction: column; }
  }
</style>
