---
import Layout from '../layouts/Layout.astro';
import members from '../data/members.json';
import { base } from '../utils/url';

const allProjects = await Astro.glob('../content/projects/*.md');
const projects = allProjects.sort((a, b) => a.frontmatter.order - b.frontmatter.order);

function getMember(name) {
  return members.find(m => m.name === name);
}
---

<Layout title="Research" description="Research projects at the LC³ Lab — AI in Education, Social Annotation, Computational Learning Analytics.">
  <section class="section">
    <p class="section-label">Research Projects</p>
    <ul class="project-list">
      {projects.map(project => (
        <li class="project-card">
          <div class="project-thumb">
            {project.frontmatter.image
              ? <img src={`${base}${project.frontmatter.image}`} alt={project.frontmatter.title} />
              : <div class="project-thumb-placeholder" />
            }
          </div>
          <div class="project-body">
            <div class="project-title-row">
              <h3><a href={`${base}/projects/${project.frontmatter.slug}`}>{project.frontmatter.title}</a></h3>
              <span class={`tag tag--status tag--${project.frontmatter.status}`}>{project.frontmatter.status}</span>
            </div>
            <p class="project-desc">{project.frontmatter.shortDescription}</p>
            <div class="project-footer">
              <ul class="member-list">
                {project.frontmatter.members.map(name => {
                  const m = getMember(name);
                  return (
                    <li class="member-item">
                      {m?.website
                        ? <a href={m.website} target="_blank" rel="noopener" class="member-link">
                            <img src={`${base}${m?.image || '/images/team/default.svg'}`} alt={name} class="member-avatar" />
                            <span>{name}</span>
                          </a>
                        : <>
                            <img src={`${base}${m?.image || '/images/team/default.svg'}`} alt={name} class="member-avatar" />
                            <span class="member-nolink">{name}</span>
                          </>
                      }
                    </li>
                  );
                })}
              </ul>
              <div class="project-tags">
                {project.frontmatter.area.map(a => <span class="tag">{a}</span>)}
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .project-list {
    list-style: none;
  }

  .project-card {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .project-card:first-child {
    border-top: 1px solid var(--border);
  }

  .project-thumb {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border-radius: 6px;
    overflow: hidden;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
  }

  .project-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-thumb-placeholder {
    width: 100%;
    height: 100%;
    background: var(--bg-subtle);
  }

  .project-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .project-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .project-card h3 {
    font-size: 0.975rem;
    line-height: 1.3;
  }

  .tag--status {
    flex-shrink: 0;
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 0.1rem 0.4rem;
  }

  .tag--active {
    background: #f0fdf4;
    color: #4ade80;
    border-color: #d1fae5;
  }

  .tag--inactive,
  .tag--completed {
    background: var(--bg-subtle);
    color: var(--text-secondary);
    border-color: var(--border);
  }

  .project-card h3 a {
    color: var(--text);
    text-decoration: none;
  }

  .project-card h3 a:hover {
    color: var(--accent);
  }

  .project-desc {
    font-size: 0.825rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .project-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.15rem;
  }

  .member-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.9rem;
  }

  .member-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .member-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    color: var(--text);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .member-link:hover span {
    text-decoration: underline;
  }

  .member-nolink {
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  .member-avatar {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    object-fit: cover;
    background: #f3f4f6;
    flex-shrink: 0;
  }

  .project-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

</style>
